# WebAuthn Configuration
RP_ID=localhost
RP_NAME=OpenCode Agent
ORIGIN=http://localhost:8000

# Security Configuration
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Application Configuration
MODEL_NAME=google/gemini-2.5-flash
UPLOAD_DIR=tmp/user_attachments

# Attach to a running opencode server for faster responses (optional)
# When set, uses --attach instead of spawning a new process per request (~30% faster)
# OPENCODE_ATTACH_URL=http://127.0.0.1:4096
